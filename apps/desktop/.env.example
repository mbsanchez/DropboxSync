DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_REDIRECT_URI=http://localhost:53682/callback

# macOS: your Apple Developer team id. Required for a working build: it names the App Group shared with the
# Finder Sync extension (<TEAM_ID>.com.dropboxsyncdesktop). Never commit a real value.
# APPLE_TEAM_ID=
