<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is REQUIRED for macOS to register a Finder Sync extension at all. Without it the
	     appex never appears in pluginkit and cannot be enabled (DBSYNC-76). Apple's Finder Sync
	     template generates this file, and every working extension on a reference Mac is sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- TEMPLATE. scripts/render-entitlements.mjs renders it to build/ (gitignored), substituting the team id
	     from APPLE_TEAM_ID (Team ID: see FinderSyncExtension/README.md, App Group ADR). The App Group is
	     how this sandboxed extension reaches the host's data directory (overlay_state.json): the container lives outside both
	     sandboxes and needs no temporary exception. Team-prefixed, so it needs no provisioning profile. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>__APP_GROUP_ID__</string>
	</array>
</dict>
</plist>
