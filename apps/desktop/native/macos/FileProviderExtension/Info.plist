<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Dropbox Sync File Provider</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The App Group id, substituted by build-appex.sh from APPLE_TEAM_ID (empty without a team), so it
	     cannot be a source literal (Team ID: see FinderSyncExtension/README.md, App Group ADR).
	     Unused by the tracer; later slices read the shared database from this container. -->
	<key>DBSyncAppGroupID</key>
	<string>$(DBSYNC_APP_GROUP_ID)</string>
	<!-- Deliberately NO NSPrincipalClass and NO LSUIElement: the installed Dropbox replicated appex
	     carries neither, and a File Provider extension has no AppKit run loop to set up. -->
	<key>NSExtension</key>
	<dict>
		<!-- Deliberately NO NSExtensionFileProviderDocumentGroup: the installed Dropbox replicated
		     appex omits it, and the group is reached through the entitlement instead. -->
		<!-- Make Available Offline and Make Online-Only (#237), as the Dropbox client offers them: the system
		     has no pin of its own for a third-party domain. The identifiers are OfflineAction's in
		     Exchange.swift; userInfo.pinned is ProjectionItem's. The name is shown as written: there is
		     no Localizable.strings to look it up in. Finder lists a provider's actions loose, with no
		     submenu, so the name says whose it is. -->
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY(fileproviderItems, $item, $item.itemIdentifier != "NSFileProviderRootContainerItemIdentifier" AND $item.userInfo.pinned != YES AND $item.userInfo.inherited != YES).@count &gt; 0</string>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>com.mobsanchez.dropboxsyncdesktop.fileprovider.action.make_offline</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>DropboxSync: Make Available Offline</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY(fileproviderItems, $item, $item.itemIdentifier != "NSFileProviderRootContainerItemIdentifier" AND $item.userInfo.inherited != YES AND ($item.userInfo.pinned == YES OR $item.isDownloaded == YES OR $item.contentType.identifier UTI-CONFORMS-TO "public.folder")).@count &gt; 0</string>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>com.mobsanchez.dropboxsyncdesktop.fileprovider.action.make_online_only</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>DropboxSync: Make Online-Only</string>
			</dict>
		</array>
		<!-- No Download Now and no Remove Download: next to the two actions above they read as the same
		     thing (measured with the maintainer). Opening a file still downloads it, and the extension's
		     own eviction is unaffected (NSFileProviderItem.h, NSFileProviderItemCapabilitiesAllowsEvicting). -->
		<key>NSExtensionFileProviderAllowsContextualMenuDownloadEntry</key>
		<false/>
		<key>NSExtensionFileProviderAllowsUserControlledEviction</key>
		<false/>
		<!-- At most this many fetchContents at once per domain: each is one download by the host. -->
		<key>NSExtensionFileProviderDownloadPipelineDepth</key>
		<integer>4</integer>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<!-- BARE class name, not module-qualified: FileProviderExtension.swift declares
		     @objc(DropboxSyncFileProvider), which REPLACES the Swift-mangled runtime name. build-appex.sh
		     checks that this matches the ObjC class the binary exports. -->
		<key>NSExtensionPrincipalClass</key>
		<string>DropboxSyncFileProvider</string>
	</dict>
</dict>
</plist>
