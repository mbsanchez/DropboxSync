<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both reference providers (Dropbox, OneDrive) carry exactly these two keys, verified
	     with codesign -d --entitlements on 2026-08-31. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)com.mobsanchez.dropboxsyncdesktop</string>
	</array>
</dict>
</plist>
