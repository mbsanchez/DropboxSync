<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both reference providers (Dropbox, OneDrive) carry exactly these two keys, verified
	     with codesign -d --entitlements on 2026-08-31.

	     Signing this file successfully proves NOTHING about whether the App Group is
	     authorized: codesign embeds whatever entitlements it is handed without validating
	     them (an invented entitlement and a nonexistent group were embedded just as
	     happily). Authorization is decided at notarization and at runtime. Neither has
	     been tested — see DBSYNC-79 / GitHub #140. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)com.mobsanchez.dropboxsyncdesktop</string>
	</array>
</dict>
</plist>
